# Host-owned deployment values. Copy outside the repository with mode 0600.
STRAM_QUAL_MCP_IMAGE=registry.example.invalid/stram/stram-qualitative-mcp
STRAM_QUAL_MCP_IMAGE_DIGEST=sha256:REPLACE_WITH_APPROVED_DIGEST
STRAM_QUAL_MCP_NETWORK=stram-qualitative-private
STRAM_QUAL_MCP_HOST_PORT=8800
STRAM_QUAL_MCP_LAKE_PATH=/srv/stram/data-lake/parquet-readonly
STRAM_QUAL_MCP_AUDIT_PATH=/srv/stram/qualitative-mcp-audit
STRAM_QUAL_MCP_AUDIT_KEY_PATH=/run/stram-secrets/qualitative-mcp-audit-key
