# Settings for `setup_host.sh ... staging AUTH_FILE`. None of these are secret, but they name a
# private host, so copy this file outside the repository and fill it in there.
STRAM_QUAL_PUBLIC_HOST=CHANGE_ME.ts.net
STRAM_QUAL_PUBLIC_PORT=8443
STRAM_QUAL_HOST_IPV4=CHANGE_ME
STRAM_QUAL_ISSUER_URL=https://CHANGE_ME.ts.net/realms/stram-staging
STRAM_QUAL_TENANT_ID=CHANGE_ME
