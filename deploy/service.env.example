# Non-secret service configuration. The audit key is file-mounted separately.
STRAM_QUAL_MCP_PARQUET_ROOT=/news/parquet
STRAM_QUAL_MCP_AUDIT_DB=/audit/audit.sqlite3
STRAM_QUAL_MCP_AUDIT_KEY_FILE=/run/secrets/audit-key
STRAM_QUAL_MCP_ISSUER_URL=https://issuer.example.invalid/
STRAM_QUAL_MCP_RESOURCE_URL=https://qualitative.example.invalid/mcp
STRAM_QUAL_MCP_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
STRAM_QUAL_MCP_TENANT_ID=REPLACE_WITH_TENANT
STRAM_QUAL_MCP_ALLOWED_HOSTS=qualitative.example.invalid
# Leave empty for non-browser MCP clients. Add only exact, reviewed browser origins.
STRAM_QUAL_MCP_ALLOWED_ORIGINS=
STRAM_QUAL_MCP_OTLP_ENDPOINT=https://otel.example.invalid
STRAM_QUAL_MCP_IMAGE_DIGEST=sha256:REPLACE_WITH_APPROVED_DIGEST
STRAM_QUAL_MCP_BIND_HOST=0.0.0.0
STRAM_QUAL_MCP_BIND_PORT=8000
STRAM_QUAL_MCP_WORKER_MAX_RESTARTS=3
STRAM_QUAL_MCP_WORKER_RESTART_BACKOFF_SECONDS=0.25
STRAM_QUAL_MCP_WORKER_SHUTDOWN_SECONDS=5
